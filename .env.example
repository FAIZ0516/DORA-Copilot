# Application
APP_NAME=DORA Copilot
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RESULT_LIMIT=1000

# Writable assistant runtime store. SQLite is suitable for local development.
# Production may use writable PostgreSQL; this is separate from read-only DoraDB.
DATABASE_URL=sqlite:///./backend/dora_runtime.db
ASSISTANT_DATABASE_SCHEMA=ai_assistant

# Real DoraDB. Use a dedicated PostgreSQL account with SELECT-only access.
DORADB_HOST=127.0.0.1
DORADB_PORT=5432
DORADB_NAME=doradb
DORADB_USER=
DORADB_PASSWORD=
DORADB_PROJECT_KEY=DCPM
DORADB_QUERY_TIMEOUT_SECONDS=10
DORADB_DETAIL_LIMIT=50

# Governed agent workflow
AGENT_MAX_TOOL_CALLS=2
AGENT_MAX_RETRIES=1
AGENT_CONFIDENCE_THRESHOLD=0.60
AGENT_WORKFLOW_TIMEOUT_SECONDS=90
AGENT_MEMORY_MAX_SESSIONS=250
AGENT_MEMORY_MAX_TURNS=12
AGENT_AUDIT_MAX_RECORDS=500
CONVERSATION_RECENT_MESSAGE_LIMIT=12
CONVERSATION_SUMMARY_TRIGGER_MESSAGES=12
CONVERSATION_SUMMARY_MAX_CHARS=3000
QUERY_RESULT_CACHE_TTL_SECONDS=300
QUERY_RESULT_CACHE_MAX_ENTRIES=6
QUERY_RESULT_CACHE_MAX_ROWS=100
QUERY_RESULT_CACHE_MAX_CHARS=30000
JIRA_DASHBOARD_CACHE_TTL_SECONDS=60

# Generative AI provider: deepseek, google-ai-studio, or ollama
LLM_PROVIDER=deepseek

# DeepSeek (used when LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_PLANNER_TEMPERATURE=0
DEEPSEEK_RESPONSE_TEMPERATURE=0.3
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_PLANNER_MAX_TOKENS=1600
DEEPSEEK_RESPONSE_MAX_TOKENS=3000

# Google AI Studio Gemini (used when LLM_PROVIDER=google-ai-studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_PLANNER_TEMPERATURE=0
GEMINI_RESPONSE_TEMPERATURE=0.3

# Local Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_PLANNER_TEMPERATURE=0
OLLAMA_RESPONSE_TEMPERATURE=0.3

# ElevenLabs on-demand text-to-speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32
ELEVENLABS_TIMEOUT_SECONDS=45
ELEVENLABS_MAX_CHARS_PER_REQUEST=2000
ELEVENLABS_MONTHLY_CHAR_LIMIT=10000

# Frontend (used by Vite when no local proxy is available)
VITE_API_BASE_URL=
