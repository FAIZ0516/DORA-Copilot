# Application
APP_NAME=DORA Copilot
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Origins allowed by pattern as well as by the list above. Deployed on Render
# and left empty, the platform's own https domain is allowed automatically, so
# a fresh deploy works before this is configured. Set it to pin the frontend
# down exactly, e.g. https://my-frontend\.onrender\.com
CORS_ORIGIN_REGEX=
RESULT_LIMIT=1000

# SQLite stores only the local ElevenLabs usage counter.
DATABASE_URL=sqlite:///./backend/dora_runtime.db

# Real DoraDB. Use a dedicated PostgreSQL account with SELECT-only access.
DORADB_HOST=127.0.0.1
DORADB_PORT=5432
DORADB_NAME=doradb
DORADB_USER=
DORADB_PASSWORD=
DORADB_PROJECT_KEY=DCPM
DORADB_QUERY_TIMEOUT_SECONDS=10
DORADB_DETAIL_LIMIT=50

# Governed agent workflow
AGENT_MAX_TOOL_CALLS=2
AGENT_MAX_RETRIES=1
AGENT_CONFIDENCE_THRESHOLD=0.60
AGENT_WORKFLOW_TIMEOUT_SECONDS=90
AGENT_MEMORY_MAX_SESSIONS=250
AGENT_MEMORY_MAX_TURNS=12
AGENT_AUDIT_MAX_RECORDS=500

# Active generative AI provider
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_PLANNER_TEMPERATURE=0
DEEPSEEK_RESPONSE_TEMPERATURE=0.3
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_PLANNER_MAX_TOKENS=1600
DEEPSEEK_RESPONSE_MAX_TOKENS=3000

# Google AI Studio Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_PLANNER_TEMPERATURE=0
GEMINI_RESPONSE_TEMPERATURE=0.3

# One pinned question answered from stored text, for recording a demonstration
# without waiting on a live answer. Leave this unset everywhere except a
# machine that is actively recording -- see backend/demo_answer.py.
DEMO_ANSWER_ENABLED=false
DEMO_ANSWER_DELAY_SECONDS=4

# ElevenLabs on-demand text-to-speech
ELEVENLABS_API_KEY=
# Must be a premade voice on your account. Library voices are refused with
# HTTP 402 on a free plan. List yours: GET https://api.elevenlabs.io/v1/voices
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32
ELEVENLABS_TIMEOUT_SECONDS=45
ELEVENLABS_MAX_CHARS_PER_REQUEST=2000
ELEVENLABS_MONTHLY_CHAR_LIMIT=10000

# Frontend (used by Vite when no local proxy is available)
VITE_API_BASE_URL=


# --- Realtime voice conversation -------------------------------------------
# Speech recognition and voice-activity detection run locally. DeepSeek stays
# the only LLM; every spoken question still goes through the governed agent.
VOICE_MODE_ENABLED=true
# "groq" uses hosted Whisper and loads no model on the server -- required on
# a small instance, where the local model exhausts memory. "faster-whisper"
# keeps recognition on the machine.
VOICE_STT_PROVIDER=groq
# Leave blank here. Set the real value in .env, which is git-ignored.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_TIMEOUT_SECONDS=30
VOICE_TTS_PROVIDER=elevenlabs
# WebRTC voice-activity detection. No model file, no tensor runtime.
VOICE_VAD_PROVIDER=webrtc
# 0 permissive .. 3 strictest. 2 keeps quiet speech, rejects room noise.
VOICE_VAD_AGGRESSIVENESS=2
# Silence that ends an utterance. Shorter cuts people off; longer feels sluggish.
VOICE_END_SILENCE_MS=700
VOICE_MAX_UTTERANCE_SECONDS=30
VOICE_SESSION_TTL_SECONDS=1800
VOICE_SAMPLE_RATE=16000
# Whisper runs on CPU by default. Set device=cuda and compute_type=float16 on a
# machine with a suitable GPU.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
